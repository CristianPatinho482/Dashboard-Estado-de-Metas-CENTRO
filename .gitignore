# Binarios de Power BI (se generan desde el PBIP)
*.pbix
*.pbit
*.abf

# Excepción: entregable del paquete de corto plazo
!Reporte_Metas_ASTIN.pbix

# Configuración local de Power BI Desktop
**/.pbi/localSettings.json
**/.pbi/editorSettings.json
**/.pbi/cache.abf

# Temporales y logs
~$*
data/qa/vigilante.log
data/qa/actualizacion.log
*.tmp
tmp_*/
*.bak

# Compilación del ejecutable
build/

# Python
__pycache__/
*.pyc
